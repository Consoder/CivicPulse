# Demo mode uses sample in-memory data; no real external API calls.
DEMO_MODE=true
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173

# Required configuration fields; leave safe placeholders in DEMO_MODE.
GEMINI_API_KEY=demo-placeholder
GROQ_API_KEY=demo-placeholder
FIREBASE_PROJECT_ID=demo-placeholder
FIREBASE_PRIVATE_KEY=demo-placeholder
FIREBASE_CLIENT_EMAIL=demo@example.invalid

# For non-demo mode: supply real values in local .env only; never commit them.
